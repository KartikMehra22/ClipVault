    "db:validate": "prisma validate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  }
