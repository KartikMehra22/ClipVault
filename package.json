{
  "name": "clipvault-monorepo",
  "version": "0.1.0",
  "description": "Privacy-first, local-first desktop clipboard manager",
  "author": "ClipVault Contributors",
  "main": "apps/desktop/dist/main/index.js",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/ensure-ports.mjs && pnpm -r --parallel dev",
    "build": "pnpm --filter @cliporbit/contracts build && pnpm --filter @cliporbit/database build && pnpm --filter @cliporbit/renderer build && pnpm --filter @cliporbit/desktop build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "pnpm --filter @cliporbit/desktop test && pnpm --filter @cliporbit/database test",
    "package:prepare": "node scripts/prepare-packaging.mjs",
    "package:dmg": "pnpm run package:prepare && electron-builder --mac dmg",
    "clean": "pnpm -r --parallel exec rm -rf dist build out .next .tsbuildinfo .packaging .packaging-modules dist-packages"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@next/eslint-plugin-next": "^16.4.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.22.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.26.0"
  }
}
